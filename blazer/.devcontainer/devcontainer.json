{
  "name": "blazer",
  "image": "mcr.microsoft.com/devcontainers/base:bookworm@sha256:99f5250dd2d5f8b11046d5662dd94c1e3c1dae56b560c7caad5ceb7edf349046",
  "features": {
    "docker-from-docker": {
      "version": "latest",
      "moby": true,
      "dockerDashComposeVersion": "v2"
    },
    "ruby": "3.0.4"
  },
  "containerEnv": {
    "SHELL": "/bin/zsh"
  },
  "extensions": [
    "github.copilot"
  ],
  "remoteUser": "vscode",
  "postCreateCommand": "sudo ./.devcontainer/postCreateCommand.sh && make install"
}